---
import type { CollectionEntry } from "astro:content";
import Footer from "@/components/Footer.astro";
import Layout from "./Layout.astro";
import HeaderEvent from "@/components/HeaderEvent.astro";
import EventLinks from "@/components/EventLinks.astro";
import Tags from "@/components/Tags.astro";
import Contribute from "@/components/Contribute.astro";
import { readableOn } from "@/color";

type Props = CollectionEntry<"organizer">;

const {
    id,
    data: { name, description, image, location, color, url, email, province },
} = Astro.props;

const API_KEY = "AIzaSyAsvWUikM_4YkcsTWBjWMPFK6-jXe7iVAs";

const onColor = readableOn(color);

const organizerSchema = {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": name,
    "description": description,
    ...(image && { "image": image.toString() }),
    ...(location && {
        "location": {
            "@type": "Place",
            "name": location,
            "address": {
                "@type": "PostalAddress",
                "addressLocality": province || "España",
                "addressCountry": "ES"
            }
        }
    }),
    ...(url && { "url": url }),
    ...(email && { "email": email })
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "Inicio",
            "item": Astro.site?.toString()
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": "Organizadores",
            "item": `${Astro.site}organizadores/`
        },
        {
            "@type": "ListItem",
            "position": 3,
            "name": name
        }
    ]
};
---

<Layout title={name} description={description}>
    <script type="application/ld+json" set:html={JSON.stringify(organizerSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <HeaderEvent title={name} color={color} url={url} />
    <main>
        <article itemscope itemtype="https://schema.org/Organization">
            <div
                class="bg-primary"
                style={`background-color: ${color}; color: ${onColor};`}
            >
                <div
                    class="w-full max-w-6xl mx-auto px-4 py-8 md:py-12 grid gap-8 md:grid-cols-[minmax(0,1fr)_16rem] md:items-end"
                >
                    {
                        image && (
                            <a
                                href={image.toString()}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="block md:order-2 w-44 sm:w-60 md:w-full justify-self-center md:justify-self-end"
                            >
                                <img
                                    src={image.toString()}
                                    alt={name}
                                    class="-rotate-y-4 hover:-rotate-y-2 hover:scale-105 transition-all shadow-lg w-full"
                                    itemprop="image"
                                    loading="lazy"
                                />
                            </a>
                        )
                    }
                    <div class="md:order-1 space-y-4 min-w-0">
                        <h1
                            class="text-4xl md:text-6xl font-light text-balance"
                            transition:name={`title-${id}`}
                            itemprop="name"
                        >
                            {name}
                        </h1>
                        {
                            description && (
                                <p class="max-w-2xl text-sm md:text-base opacity-90">
                                    {description}
                                </p>
                            )
                        }
                    </div>
                </div>
            </div>
            <div class="border-b border-line" style={`--event: ${color};`}>
                <EventLinks {...Astro.props} />
            </div>
            {
                location && (
                    <iframe
                        id="map"
                        width="100%"
                        title={`Mapa de ${location}`}
                        class="h-48 border-b border-line"
                        loading="lazy"
                        allowfullscreen
                        referrerpolicy="no-referrer-when-downgrade"
                        src={`https://www.google.com/maps/embed/v1/place?key=${API_KEY}&q=${encodeURIComponent(location)}`}
                    />
                )
            }
            <div class="w-full max-w-6xl mx-auto py-8 px-4">
                <meta itemprop="description" content={description} />
                <Tags {...Astro.props} />
                <section class="content mt-6">
                    <slot />
                </section>
                <div class="mt-8">
                    <Contribute id={id} collection="organizers" />
                </div>
            </div>
        </article>
    </main>
    <Footer compact />
</Layout>
