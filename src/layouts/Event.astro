---
import type { CollectionEntry } from "astro:content";
import Footer from "@/components/Footer.astro";
import Dates from "@/components/Dates.astro";
import Layout from "./Layout.astro";
import { AddToCalendarButton } from "add-to-calendar-button-react";
import HeaderEvent from "@/components/HeaderEvent.astro";
import EventLinks from "@/components/EventLinks.astro";
import Tags from "@/components/Tags.astro";
import Contribute from "@/components/Contribute.astro";
import { readableOn } from "@/color";

type Props = CollectionEntry<"event">;

const {
    id,
    data: {
        title,
        description,
        start,
        end,
        startTime,
        endTime,
        image,
        location,
        color,
        url,
        email,
        province,
        tags,
    },
} = Astro.props;

// El color del evento tiñe la cabecera y los acentos; el texto que va
// encima se calcula para que cualquier color siga siendo legible, porque
// esta ficha funciona como landing del organizador.
const onColor = readableOn(color);

const startDateStr = start.toISOString().split("T")[0];
const startDate = startTime ? `${startDateStr}T${startTime}:00` : start.toISOString();

let endDate: string;
if (end && endTime) {
    endDate = `${end.toISOString().split("T")[0]}T${endTime}:00`;
} else if (end) {
    endDate = end.toISOString();
} else if (endTime) {
    endDate = `${startDateStr}T${endTime}:00`;
} else {
    endDate = start.toISOString();
}

const mapQuery = location
    ? `${location}${province && !location.includes(province) ? `, ${province}` : ""}, España`
    : "";

const organizerUrl = url ?? Astro.url.toString();
const organizerName = url
    ? new URL(url).hostname.replace(/^www\./, "")
    : title;

const eventSchema = {
    "@context": "https://schema.org",
    "@type": "Event",
    "name": title,
    "description": description,
    "startDate": startDate,
    "endDate": endDate,
    "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
    "eventStatus": "https://schema.org/EventScheduled",
    ...(location && {
        "location": {
            "@type": "Place",
            "name": location,
            "address": {
                "@type": "PostalAddress",
                "addressLocality": province || "España",
                "addressCountry": "ES"
            }
        }
    }),
    ...(image && { "image": image.toString() }),
    "url": url ?? Astro.url.toString(),
    "organizer": {
        "@type": "Organization",
        "name": organizerName,
        "url": organizerUrl,
        ...(email && { "email": email })
    },
    ...(tags && tags.length > 0 && { "keywords": tags.join(", ") }),
    "offers": {
        "@type": "Offer",
        "url": Astro.url.toString(),
        "availability": "https://schema.org/InStock",
        "price": "0",
        "priceCurrency": "EUR",
        "validFrom": startDate
    }
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "Inicio",
            "item": Astro.site?.toString()
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": "Eventos",
            "item": `${Astro.site}eventos/`
        },
        ...(province ? [{
            "@type": "ListItem",
            "position": 3,
            "name": province,
            "item": `${Astro.site}eventos/${province.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "")}/`
        }] : []),
        {
            "@type": "ListItem",
            "position": province ? 4 : 3,
            "name": title
        }
    ]
};
---

<Layout title={title} description={description}>
    <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <HeaderEvent title={title} color={color} url={url} />
    <main>
        <article itemscope itemtype="https://schema.org/Event">
            <div
                class="bg-primary"
                style={`background-color: ${color}; color: ${onColor};`}
            >
                <div
                    class="w-full max-w-6xl mx-auto px-4 py-6 md:py-8"
                >
                    <div class="max-w-3xl space-y-3">
                        <p
                            class="text-sm md:text-base"
                            transition:name={`date-${id}`}
                        >
                            <Dates {...Astro.props.data} />
                        </p>
                        <h1
                            class="text-3xl md:text-5xl font-light text-balance"
                            transition:name={`title-${id}`}
                            itemprop="name"
                        >
                            {title}
                        </h1>
                        <p class="max-w-2xl text-sm opacity-90">
                            {description}
                        </p>
                    </div>
                </div>
            </div>
            <div class="border-b border-line" style={`--event: ${color};`}>
                <EventLinks {...Astro.props}>
                    <div
                        class="atcb-wrapper"
                        style="--btn-background: #181818; --btn-hover-background: #333333; --btn-border: #181818; --btn-hover-border: #333333; --btn-text: #ffffff; --btn-hover-text: #ffffff; --btn-text-shadow: transparent;"
                    >
                        <AddToCalendarButton
                            client:only
                            label="Añadir al calendario"
                            language="es"
                            name={title}
                            options="'Apple','Google','iCal','Outlook.com','Yahoo'"
                            location={location}
                            startDate={start.toISOString().split("T")[0]}
                            endDate={end?.toISOString().split("T")[0]}
                            startTime={startTime}
                            endTime={endTime}
                            timeZone="Europe/Madrid"
                            buttonStyle="flat"
                            lightMode="dark"
                        />
                    </div>
                </EventLinks>
            </div>
            {
                location && (
                    <div
                        id="event-map"
                        class="relative z-0 h-48 border-b border-line"
                        data-estado="cargando"
                        data-query={mapQuery}
                        data-title={`Mapa de ${location}`}
                        data-label={location}
                        data-province={province ?? ""}
                        data-color={color ?? "#181818"}
                    >
                        <span
                            data-map-cargando
                            class="hidden [[data-estado=cargando]_&]:flex h-full w-full items-center justify-center text-sm text-muted"
                        >
                            Cargando mapa…
                        </span>
                        <a
                            data-map-enlace
                            class="hidden [[data-estado=fallback]_&]:flex h-full w-full items-center justify-center gap-2 text-sm text-muted hover:underline"
                            href={`https://www.openstreetmap.org/search?query=${encodeURIComponent(mapQuery)}`}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            Ver ubicación en OpenStreetMap
                        </a>
                        <noscript>
                            <style>
                                #event-map [data-map-enlace] {
                                    display: flex;
                                }
                                #event-map [data-map-cargando] {
                                    display: none;
                                }
                            </style>
                        </noscript>
                    </div>
                )
            }
            <div
                class:list={[
                    "w-full max-w-6xl mx-auto py-8 px-4 grid gap-10 lg:items-start",
                    image
                        ? "lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-14"
                        : "",
                ]}
            >
                <div class="min-w-0">
                    <meta itemprop="description" content={description} />
                    <span
                        itemprop="organizer"
                        itemscope
                        itemtype="https://schema.org/Organization"
                        style="display: none;"
                    >
                        <meta itemprop="name" content={organizerName} />
                        <meta itemprop="url" content={organizerUrl} />
                        {email && <meta itemprop="email" content={email} />}
                    </span>
                    <Tags {...Astro.props} />
                    <section class="content mt-6">
                        <slot />
                    </section>
                    <div class="mt-8">
                        <Contribute id={id} collection="events" />
                    </div>
                </div>
                {
                    image && (
                        <aside class="lg:sticky lg:top-16 self-start">
                            <a
                                href={image.toString()}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="block w-52 sm:w-64 lg:w-full mx-auto lg:mx-0"
                            >
                                <img
                                    src={image.toString()}
                                    alt={title}
                                    class="-rotate-y-4 hover:-rotate-y-2 hover:scale-105 transition-all shadow-lg w-full"
                                    itemprop="image"
                                    loading="lazy"
                                />
                            </a>
                        </aside>
                    )
                }
            </div>
        </article>
        <slot name="related" />
    </main>
    <Footer compact />
</Layout>

<script>
    const el = document.getElementById("event-map");
    const query = el?.dataset.query;

    const LEAFLET = "1.9.4";
    const CACHE_KEY = "event-map-geo";
    const PAUSA_MS = 350;

    function loadLeaflet(): Promise<any> {
        return new Promise((resolve, reject) => {
            if ((window as any).L) return resolve((window as any).L);

            const css = document.createElement("link");
            css.rel = "stylesheet";
            css.href = `https://unpkg.com/leaflet@${LEAFLET}/dist/leaflet.css`;
            document.head.appendChild(css);

            const js = document.createElement("script");
            js.src = `https://unpkg.com/leaflet@${LEAFLET}/dist/leaflet.js`;
            // Se espera tambien al CSS: sin el, Leaflet calcula mal el
            // tamano de los controles al montar el mapa.
            js.onload = () =>
                css.sheet
                    ? resolve((window as any).L)
                    : (css.onload = () => resolve((window as any).L));
            js.onerror = reject;
            document.head.appendChild(js);
        });
    }

    function candidatas(q: string, provincia: string): string[] {
        const partes = q
            .split(",")
            .map((parte) => parte.trim())
            .filter(Boolean);
        const lista: string[] = [];
        for (let i = 0; i < partes.length - 1; i++) {
            lista.push(partes.slice(i).join(", "));
        }

        if (provincia && !partes.includes(provincia)) {
            lista.push(`${provincia}, España`);
        }

        return lista.length > 0 ? lista : [q];
    }

    const pausa = (ms: number) => new Promise((r) => setTimeout(r, ms));

    function leerCache(): Record<string, { lat: number; lon: number } | null> {
        try {
            return JSON.parse(sessionStorage.getItem(CACHE_KEY) ?? "{}");
        } catch {
            return {};
        }
    }

    function escribirCache(cache: Record<string, unknown>) {
        try {
            sessionStorage.setItem(CACHE_KEY, JSON.stringify(cache));
        } catch {
            // Sin almacenamiento disponible el mapa sigue funcionando.
        }
    }

    async function buscarUna(q: string) {
        const url =
            "https://nominatim.openstreetmap.org/search" +
            `?format=jsonv2&limit=1&countrycodes=es&q=${encodeURIComponent(q)}`;

        const res = await fetch(url, { headers: { Accept: "application/json" } });
        if (!res.ok) return undefined;

        const results: Array<{ lat: string; lon: string }> = await res.json();
        const hit = results[0];
        const lat = Number(hit?.lat);
        const lon = Number(hit?.lon);
        if (!Number.isFinite(lat) || !Number.isFinite(lon)) return null;
        return { lat, lon };
    }

    async function geocode(q: string) {
        const cache = leerCache();

        const provincia = el?.dataset.province ?? "";

        for (const intento of candidatas(q, provincia)) {
            if (intento in cache) {
                // null guardado significa "Nominatim no lo encuentra".
                if (cache[intento]) return cache[intento];
                continue;
            }

            const punto = await buscarUna(intento).catch(() => undefined);
            await pausa(PAUSA_MS);

            if (punto === undefined) continue;

            // Se guardan tambien los no encontrados, para no repetirlos.
            cache[intento] = punto;
            escribirCache(cache);
            if (punto) return punto;
        }

        return null;
    }

    if (el && query) {
        if (el.dataset.mapReady !== "1") {
            el.dataset.mapReady = "1";

            const estado = (valor: string) => el.setAttribute("data-estado", valor);

            const sinMapa = () => estado("fallback");

            geocode(query)
                .then((point) => {
                    if (!point) return sinMapa();
                    return loadLeaflet().then((L) => render(L, point)).catch(sinMapa);
                })
                .catch(sinMapa);
        }
    }

    function render(L: any, point: { lat: number; lon: number }) {
        if (!el) return;

        const color = el.dataset.color ?? "#181818";
        const label = el.dataset.label ?? "";

        el.replaceChildren();

        const map = L.map(el, {
            zoomControl: false,
            scrollWheelZoom: false,
        }).setView([point.lat, point.lon], 15);

        map.getPane("tilePane").style.filter = "grayscale(1) brightness(1.05)";

        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            maxZoom: 19,
            attribution:
                '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
        }).addTo(map);

        L.control.zoom({ position: "topright" }).addTo(map);

        const icon = L.divIcon({
            className: "",
            html: `<span style="display:block;width:18px;height:18px;border-radius:50%;background:${color};border:3px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.4)"></span>`,
            iconSize: [18, 18],
            iconAnchor: [9, 9],
        });

        const marker = L.marker([point.lat, point.lon], { icon }).addTo(map);
        if (label) {
            marker.bindPopup(label);
        }
    }
</script>
