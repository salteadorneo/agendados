---
import type { CollectionEntry } from "astro:content";
import Footer from "@/components/Footer.astro";
import Dates from "@/components/Dates.astro";
import Layout from "./Layout.astro";
import { AddToCalendarButton } from "add-to-calendar-button-react";
import HeaderEvent from "@/components/HeaderEvent.astro";
import Tags from "@/components/Tags.astro";
import Social from "@/components/Social.astro";

type Props = CollectionEntry<"event">;

const {
    id,
    data: {
        title,
        description,
        start,
        end,
        startTime,
        endTime,
        image,
        location,
        color,
        url,
        email,
        province,
    },
} = Astro.props;

const API_KEY = "AIzaSyAsvWUikM_4YkcsTWBjWMPFK6-jXe7iVAs";
---

<Layout title={title} description={description}>
    <HeaderEvent title={title} color={color} />
    <main>
        <article itemscope itemtype="https://schema.org/Event">
            <div
                class={`relative flex items-end py-6 bg-primary bg-center bg-cover bg-no-repeat ${!image && "overflow-hidden2"}`}
                style={`background-color: ${color};`}
            >
                <div class="relative w-full max-w-6xl mx-auto px-4 space-y-2">
                    {
                        image && (
                            <a
                                href={image.toString()}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="block sm:absolute top-0 mx-auto right-6 z-30 w-[40dvw] sm:w-52 perspective-dramatic max-sm:mb-6"
                            >
                                <img
                                    src={image.toString()}
                                    alt={description || title}
                                    class="-rotate-y-4 hover:-rotate-y-2 hover:scale-110 transition-all shadow-md"
                                    itemprop="image"
                                />
                            </a>
                        )
                    }
                    {
                        !image && (
                            <div class="max-sm:hidden absolute top-0 mx-auto right-6 z-30 w-[40dvw] sm:w-52 perspective-dramatic max-sm:mb-6">
                                <div
                                    class="aspect-[9/14] bg-white text-sm p-6 -rotate-y-4 shadow-md"
                                    style={`background-color2: ${color};`}
                                >
                                    {description}
                                </div>
                            </div>
                        )
                    }
                    <div
                        class="text-xl text-white"
                        transition:name={`date-${id}`}
                    >
                        <Dates
                            start={start}
                            end={end}
                            startTime={startTime}
                            endTime={endTime}
                        />
                    </div>
                    <h1
                        class="sm:pr-60 text-5xl md:text-6xl text-balance text-white font-medium"
                        transition:name={`title-${id}`}
                        itemprop="name"
                    >
                        {title}
                    </h1>
                </div>
            </div>
            <div
                class="bg-primary h-2 [clip-path:polygon(0_0,_100%_0,_90%_0,_0%_100%)] sm:[clip-path:polygon(0_0,_100%_0,_60%_0,_0%_100%)]"
                style={`background-color: ${color};`}
            >
            </div>
            <div
                class="py-4 space-y-4 border-b"
                style={`border-color: ${color};`}
            >
                <div
                    class="w-full max-w-6xl mx-auto px-4 sm:pr-60 flex flex-col sm:flex-row flex-wrap justify-between gap-3"
                >
                    <div class="flex flex-col sm:flex-row flex-wrap gap-3">
                        {
                            location && (
                                <p
                                    class="flex items-center gap-2"
                                    transition:name={`location-${id}`}
                                    itemprop="location"
                                    itemscope
                                    itemtype="https://schema.org/Place"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="24"
                                        height="24"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <path
                                            stroke="none"
                                            d="M0 0h24v24H0z"
                                            fill="none"
                                        />
                                        <path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" />
                                        <path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z" />
                                    </svg>
                                    <span
                                        class="max-sm:truncate max-sm:max-w-xs"
                                        itemprop="name"
                                    >
                                        {location}
                                    </span>
                                    <div
                                        itemprop="address"
                                        itemscope
                                        itemtype="https://schema.org/PostalAddress"
                                        style="display: none;"
                                    >
                                        <meta
                                            itemprop="addressLocality"
                                            content={province || "España"}
                                        />
                                        <meta
                                            itemprop="addressCountry"
                                            content="ES"
                                        />
                                    </div>
                                </p>
                            )
                        }
                        {
                            url && (
                                <a
                                    href={url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="flex items-center gap-2 hover:text-primary transition-colors"
                                    onmouseover={`this.style.color='${color}'`}
                                    onmouseout={`this.style.color='inherit'`}
                                    itemprop="url"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="24"
                                        height="24"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <path
                                            stroke="none"
                                            d="M0 0h24v24H0z"
                                            fill="none"
                                        />
                                        <path d="M9 15l6 -6" />
                                        <path d="M11 6l.463 -.536a5 5 0 0 1 7.071 7.072l-.534 .464" />
                                        <path d="M13 18l-.397 .534a5.068 5.068 0 0 1 -7.127 0a4.972 4.972 0 0 1 0 -7.071l.524 -.463" />
                                    </svg>
                                    {new URL(url).hostname.replace("www.", "")}
                                </a>
                            )
                        }
                        {
                            email && (
                                <a
                                    href={`mailto:${email}`}
                                    data-simple-event="event_mailto"
                                    class="flex items-center gap-2 hover:text-primary transition-colors"
                                    onmouseover={`this.style.color='${color}'`}
                                    onmouseout={`this.style.color='inherit'`}
                                    itemprop="organizer"
                                    itemscope
                                    itemtype="https://schema.org/Organization"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="24"
                                        height="24"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <path
                                            stroke="none"
                                            d="M0 0h24v24H0z"
                                            fill="none"
                                        />
                                        <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
                                        <path d="M3 7l9 6l9 -6" />
                                    </svg>
                                    <span itemprop="email">{email}</span>
                                </a>
                            )
                        }
                    </div>
                    <Social
                        {...Astro.props}
                        class="flex flex-col sm:flex-row flex-wrap gap-3"
                    />
                </div>
            </div>
            {
                location && (
                    <iframe
                        id="map"
                        width="100%"
                        class="h-48 shadow-md"
                        loading="lazy"
                        allowfullscreen
                        referrerpolicy="no-referrer-when-downgrade"
                        src={`https://www.google.com/maps/embed/v1/place?key=${API_KEY}&q=${encodeURIComponent(location)}`}
                    />
                )
            }
            <div class="w-full max-w-6xl mx-auto py-6 px-4 md:pr-60 space-y-4">
                <meta itemprop="description" content={description} />
                <Tags {...Astro.props} />
                <section class="content">
                    <slot />
                </section>
                <section class="flex flex-wrap items-center gap-2">
                    <AddToCalendarButton
                        client:only
                        label="Añadir al calendario"
                        language="es"
                        name={title}
                        options="'Apple','Google','iCal','Outlook.com','Yahoo'"
                        location={location}
                        startDate={start.toISOString().split("T")[0]}
                        endDate={end?.toISOString().split("T")[0]}
                        startTime={startTime}
                        endTime={endTime}
                        timeZone="Europe/Madrid"
                    />
                </section>
            </div>
            <div class="w-full max-w-6xl mx-auto pb-6 px-4">
                <p
                    class="bg-primary/70 text-white text-center text-sm p-4 [clip-path:polygon(1%_0,100%_0,99%_100%,0_100%)]"
                >
                    Si tienes más datos sobre este evento, por favor,
                    <a href="/contacto" class="underline hover:no-underline"
                        >contáctanos</a
                    >, escríbenos a
                    <a
                        href="mailto:contacto@agendados.es"
                        data-simple-event="footer_event_mailto"
                        class="underline hover:no-underline"
                        >contacto@agendados.es</a
                    >
                    o edítalo en
                    <a
                        href={`https://github.com/salteadorneo/agendados/blob/main/src/content/events/${id}.md`}
                        class="underline hover:no-underline"
                        target="_blank"
                        rel="noopener noreferrer">GitHub</a
                    >
                </p>
            </div>
        </article>
    </main>
    <Footer />
</Layout>

<style is:inline>
    .content h1,
    .content h2,
    .content h3,
    .content h4,
    .content h5,
    .content h6 {
        font-weight: 500;
        margin-bottom: 1rem;
    }

    .content h1 {
        font-size: 2rem;
    }

    .content h2 {
        font-size: 1.6rem;
    }

    .content h3 {
        font-size: 1.3rem;
    }

    .content h4 {
        font-size: 1.1rem;
    }

    .content a {
        text-decoration: underline;
    }

    .content p,
    .content ul,
    .content ol {
        margin-bottom: 1rem;
    }

    .content b,
    .content strong {
        font-weight: 600;
    }
</style>
