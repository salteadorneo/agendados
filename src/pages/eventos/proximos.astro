---
import { getCollection } from "astro:content";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";
import List from "@/components/List.astro";
import Title from "@/components/Title.astro";
import Calendar from "@/components/Calendar.astro";
import { getFutureEvents } from "@/utils";

const events = (await getCollection("event")).filter(
	(event) => !event.data.startRecur,
);

const futures = getFutureEvents(events);
---

<Layout
    title="Próximos eventos de juegos de mesa y rol"
    description="Consulta los próximos eventos de juegos de mesa, rol y wargames que se celebran en España. No te pierdas ninguna partida."
>
    <Header />
    <main class="flex-1 mb-6">
        <Title title="Próximos eventos" />
        <section class="w-full max-w-6xl mx-auto px-4 grid grid-cols-2 gap-8">
            <section class="w-full max-w-6xl mx-auto px-4 py-6">
                <List events={futures} />
            </section>
            <section>
                <Calendar events={events} class="h-[1500px]" />
            </section>
        </section>
    </main>
    <Footer />
</Layout>
