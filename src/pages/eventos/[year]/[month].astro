---
import { type CollectionEntry, getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { slugify } from "@/utils";
import List from "@/components/List.astro";
import Title from "@/components/Title.astro";
import Calendar from "@/components/Calendar.astro";

export async function getStaticPaths() {
    const events = await getCollection("event");
    const years = new Set<number>();
    
    events.forEach((event: CollectionEntry<"event">) => {
        const start = event.data.start;
        years.add(start.getFullYear());
    });

    const paths: any[] = [];
    const monthNames = [
        "enero",
        "febrero",
        "marzo",
        "abril",
        "mayo",
        "junio",
        "julio",
        "agosto",
        "septiembre",
        "octubre",
        "noviembre",
        "diciembre",
    ];

    years.forEach((year) => {
        monthNames.forEach((monthName, index) => {
            paths.push({
                params: {
                    year: year.toString(),
                    month: slugify(monthName),
                },
                props: { year: year.toString(), month: monthName },
            });
        });
    });

    return paths;
}

const { year, month } = Astro.props;

const events = (await getCollection(
    "event",
    ({ data }) =>
        data.start.getFullYear() === parseInt(year) &&
        data.start.toLocaleString("es-ES", { month: "long" }) === month,
)).filter((event) => !event.data.startRecur);

const getNumberFromMonth = (month: string): number => {
    const months = [
        "enero",
        "febrero",
        "marzo",
        "abril",
        "mayo",
        "junio",
        "julio",
        "agosto",
        "septiembre",
        "octubre",
        "noviembre",
        "diciembre",
    ];
    return months.indexOf(month.toLowerCase()) + 1;
};

const monthNumber = getNumberFromMonth(month);
let nextMonthDate = new Date(parseInt(year), monthNumber, 1);
const nextYear = nextMonthDate.getFullYear();
const nextMonthName = nextMonthDate.toLocaleString("es-ES", { month: "long" });
const nextMonthSlug = slugify(nextMonthName);

let prevMonthDate = new Date(parseInt(year), monthNumber - 2, 1);
const prevYear = prevMonthDate.getFullYear();
const prevMonthName = prevMonthDate.toLocaleString("es-ES", { month: "long" });
const prevMonthSlug = slugify(prevMonthName);
---

<Layout
    title={`Eventos ${month} de ${year}`}
    description={`Listado de eventos de juegos de mesa en ${month} de ${year}.`}
>
    <Header />
    <main class="flex-1 mb-6">
        <Title title={`Eventos ${month} de ${year}`}>
            <div class="flex gap-2">
                <a
                    href={`/eventos/${prevYear}/${prevMonthSlug}/`}
                    class="px-3.5 py-1.5 bg-white/15 hover:bg-white/25 transition-colors text-white"
                    title={`Eventos ${prevMonthName} ${prevYear}`}
                    aria-label={`Eventos de ${prevMonthName} de ${prevYear}`}
                >
                    &lt;
                </a>
                <a
                    href={`/eventos/${nextYear}/${nextMonthSlug}/`}
                    class="px-3.5 py-1.5 bg-white/15 hover:bg-white/25 transition-colors text-white"
                    title={`Eventos ${nextMonthName} ${nextYear}`}
                    aria-label={`Eventos de ${nextMonthName} de ${nextYear}`}
                >
                    &gt;
                </a>
            </div>
        </Title>
        <section
            class="w-full max-w-6xl mx-auto px-4 grid md:grid-cols-2 gap-8 mt-6"
        >
            <section>
                <List events={events} />
            </section>
            <section>
                <Calendar
                    date={new Date(`${year}-${getNumberFromMonth(month)}-01`)}
                    events={events}
                    showToolbarNav={false}
                />
            </section>
        </section>
        <section class="w-full max-w-6xl mx-auto px-4 flex flex-wrap gap-4 justify-center mt-8 mb-6">
            <a
                href={`/eventos/${prevYear}/${prevMonthSlug}/`}
                class="btn whitespace-nowrap"
            >
                &lt; {prevMonthName} {prevYear}
            </a>
            <a
                href={`/eventos/${nextYear}/${nextMonthSlug}/`}
                class="btn whitespace-nowrap"
            >
                {nextMonthName} {nextYear} &gt;
            </a>
        </section>
    </main>
    <Footer />
</Layout>
