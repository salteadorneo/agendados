---
import { getCollection } from "astro:content";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";
import Calendar from "@/components/Calendar.astro";
import Title from "@/components/Title.astro";
import EventMini from "@/components/EventMini.astro";
import Map from "@/components/Map.astro";
import { getFutureEvents } from "@/utils";

const events = (await getCollection("event")).filter(
	(event) => event.data.startRecur,
);

const futures = getFutureEvents(events);
---

<Layout title="Eventos recurrentes de juegos de mesa" description="Calendario de eventos semanales y recurrentes de juegos de mesa y rol en España. Encuentra partidas habituales cerca de ti.">
	<Header />
	<main class="flex-1 mb-6">
		<Title title="Calendario de eventos recurrentes" />
		<section class="w-full max-w-6xl mx-auto px-4">
			<section class="flex flex-col lg:flex-row items-start gap-8">
				<section class="w-full lg:flex-1 py-6">
					<Calendar events={events} initialView="dayGridWeek" />
					<!-- <section class="pt-4">
						<label>
							<input
								type="checkbox"
								onclick='location.href = "/"'
								checked
							/>
							Eventos recurrentes
						</label>
					</section> -->
				</section>
				<section class="lg:basis-[350px] pb-6 lg:py-6">
					<h2 class="text-2xl mb-4">Próximos eventos</h2>
					<div class="space-y-2">
						{
							futures.map((event) => (
								<EventMini {...event} class="hidden" />
							))
						}
					</div>
				</section>
			</section>
		</section>
		<section class="w-full max-w-6xl mx-auto px-4 mb-8">
			<div class="mb-4">
				<h2 class="text-2xl">Mapa</h2>
				<p>
					Haz clic en tu provincia para ver los eventos que se
					celebran cerca de ti.
				</p>
			</div>
			<Map />
		</section>
		<section
			class="w-full max-w-6xl mx-auto px-4 flex flex-col xl:flex-row items-start gap-8"
		>
			<p>
				¿Quieres contribuir con un evento o corregir algún dato? La web
				es de código abierto. Entra en <a
					href="https://github.com/salteadorneo/agendados"
					class="text-primary underline hover:no-underline"
					>nuestro repositorio de GitHub</a
				> y envíanos un pull request. Si no sabes cómo hacerlo,
				<a
					href="/contacto"
					class="text-primary underline hover:no-underline"
					>contáctanos</a
				> o escríbenos a
				<a
					href="mailto:contacto@agendados.es"
					data-simple-event="home_mailto"
					class="text-primary underline hover:no-underline"
				>
					contacto@agendados.es</a
				>.
			</p>
		</section>
	</main>
</Layout>
<Footer />

<script is:inline>
	const events = document.querySelectorAll("[data-event-start]");
	let i = 0;
	events.forEach((event) => {
		const date = new Date(event.dataset.eventStart);
		const yesterday = new Date();
		yesterday.setDate(yesterday.getDate() - 1);
		if (date > yesterday) {
			i++;
			if (i <= 4) {
				event.classList.remove("hidden");
			}
		}
	});
</script>
