---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getFutureEvents, getPastEvents, provinces, slugify } from "@/utils";
import List from "@/components/List.astro";
import Title from "@/components/Title.astro";
import Calendar from "@/components/Calendar.astro";

export async function getStaticPaths() {
    return Array.from(provinces).map((province) => ({
        params: { province: slugify(province) },
        props: { province },
    }));
}

const { province } = Astro.props;

const events = (await getCollection(
    "event",
    ({ data }) =>
        data.province && Astro.params.province.match(slugify(data.province)),
)).filter((event) => !event.data.startRecur);

const future = getFutureEvents(events);
const past = getPastEvents(events);

const firstUpcomingDate = future.length > 0
	? future[0].instanceDate || new Date(future[0].data.start)
	: null;

const shops = await getCollection(
    "shop",
    ({ data }) => data.provinces && data.provinces.includes(province),
);

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "Inicio",
            "item": Astro.site?.toString()
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": "Eventos",
            "item": `${Astro.site}eventos/`
        },
        {
            "@type": "ListItem",
            "position": 3,
            "name": province
        }
    ]
};

const collectionSchema = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": `Eventos en ${province}`,
    "description": `Listado de eventos de juegos de mesa, rol y wargames en ${province}, España.`,
    "url": `${Astro.site}eventos/${slugify(province)}/`,
    "inLanguage": "es-ES"
};
---

<Layout
    title={`Eventos en ${province}`}
    description={`Listado de eventos de juegos de mesa, rol y wargames en ${province}, España.`}
>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
    <Header />
    <main class="flex-1 mb-6">
        <Title title={`Eventos en ${province}`} />
        <section
            class="w-full max-w-6xl mx-auto px-4 grid md:grid-cols-2 gap-8 mt-6"
        >
            <section>
                <h2 class="text-3xl mb-4">
                    Próximos eventos en {province}
                </h2>
                {
                    future.length === 0 && (
                        <p class="text-gray-500">
                            No hay eventos próximos en {province}.
                        </p>
                    )
                }
                <List events={future} />

                <a
                    href={`/eventos/${slugify(province)}/pasados`}
                    class="inline-block mt-4 text-primary underline hover:no-underline"
                >
                    Ver eventos pasados en {province}
                </a>
            </section>
            <section>
                <Calendar events={events} date={firstUpcomingDate?.toISOString()} class="h-[600px]!" />

                {
                    shops.length > 0 && (
                        <section class="w-full mt-6">
                            <h2 class="text-3xl mb-4">
                                Tiendas de juegos en {province}
                            </h2>
                            <div class="space-y-2">
                                {shops.map(({ data }) => (
                                    <article
                                        class="p-4 border-l-20 bg-center bg-cover bg-no-repeat hover:bg-[var(--event-color)] transition-colors"
                                        style={`border-color: ${data.color}; --event-color: ${data.color || "#181818"}11;`}
                                    >
                                        <a
                                            href={data.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            {data.image && (
                                                <img
                                                    src={data.image.toString()}
                                                    alt={data.name}
                                                    class="h-12 object-contain"
                                                    itemprop="image"
                                                />
                                            )}
                                        </a>
                                    </article>
                                ))}
                            </div>
                        </section>
                    )
                }
            </section>
        </section>
    </main>
    <Footer />
</Layout>
