---
import { type CollectionEntry, getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getFutureEvents, getPastEvents, slugify } from "@/utils";
import List from "@/components/List.astro";
import Title from "@/components/Title.astro";
import Calendar from "@/components/Calendar.astro";
import EventMini from "@/components/EventMini.astro";
import Product from "@/components/Product.astro";
import products from "@/products.json";

export async function getStaticPaths() {
    const events = await getCollection("event");
    const tags = new Set<string>();
    events.forEach((event: CollectionEntry<"event">) => {
        event.data.tags?.forEach((tag) => {
            if (tag) tags.add(tag);
        });
    });
    return Array.from(tags).map((tag) => ({
        params: { tag: slugify(tag) },
        props: { tag },
    }));
}

const { tag } = Astro.props;

const events = (await getCollection(
    "event",
    ({ data }) =>
        data.tags &&
        data.tags.some((t) => t && Astro.params.tag.match(slugify(t))),
)).filter((event) => !event.data.startRecur);

const futures = getFutureEvents(events);
const past = getPastEvents(events);
const firstUpcomingDate = futures.length > 0
    ? futures[0].instanceDate || new Date(futures[0].data.start)
    : null;

const shops = (await getCollection("shop")).filter(
    (shop) => shop.data.section && shop.data.section.find((s) => s.name == tag),
);

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "Inicio",
            "item": Astro.site?.toString()
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": "Eventos",
            "item": `${Astro.site}eventos/`
        },
        {
            "@type": "ListItem",
            "position": 3,
            "name": tag
        }
    ]
};

const collectionSchema = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": `Eventos de ${tag}`,
    "description": `Listado de eventos de juegos de mesa con la etiqueta ${tag} en España.`,
    "url": `${Astro.site}eventos/tag/${slugify(tag)}/`,
    "inLanguage": "es-ES"
};
---

<Layout
    title={`Eventos de ${tag}`}
    description={`Listado de eventos de juegos de mesa con la etiqueta ${tag} en España.`}
>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
    <Header />
    <main class="flex-1 mb-6">
        <Title title={`Eventos de ${tag}`} />
        <section
            class="w-full max-w-6xl mx-auto px-4 grid md:grid-cols-2 gap-8 mt-6"
        >
            <section>
                <h2 class="text-3xl mb-4">Próximos eventos de {tag}</h2>
                {
                    futures.length === 0 && (
                        <p class="text-gray-500">No hay próximos eventos.</p>
                    )
                }
                <List events={futures} />

                {
                    past.length > 0 && (
                        <a
                            href={`/eventos/tag/${slugify(tag)}/pasados`}
                            class="inline-block mt-4 text-primary underline hover:no-underline"
                        >
                            Ver eventos pasados de {tag}
                        </a>
                    )
                }
            </section>
            <section>
                <Calendar events={events} date={firstUpcomingDate?.toISOString()} class="h-150!" />

                {
                    shops.length > 0 && (
                        <section class="w-full mt-6">
                            <h2 class="text-2xl mb-4">Tiendas</h2>
                            <div class="space-y-2">
                                {shops.map(({ data }) => (
                                    <article
                                        class="p-4 border-l-6 bg-center bg-cover bg-no-repeat hover:bg-(--event-color) transition-colors"
                                        style={`border-color: ${data.color}; --event-color: ${data.color || "#181818"}11;`}
                                    >
                                        <a
                                            href={`${data.url}&url=${data.section?.find((s) => s.name === tag)?.url}`}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            {data.image && (
                                                <img
                                                    src={data.image.toString()}
                                                    alt={data.name}
                                                    class="h-8 object-contain"
                                                />
                                            )}
                                            <p class="ml-1 mt-1 text-sm">
                                                Sección de {tag} en {data.name}
                                            </p>
                                        </a>
                                    </article>
                                ))}
                            </div>
                        </section>
                    )
                }
            </section>
        </section>

        {
            tag in products && (
                <section class="w-full max-w-6xl mx-auto px-4 mt-6">
                    <h2 class="text-3xl mb-4">Puede que te guste...</h2>
                    <section class="flex flex-wrap gap-0.5">
                        {products[tag as keyof typeof products]?.map(
                            (product: any) => (
                                <Product data={{ ...product }} />
                            ),
                        )}
                    </section>
                </section>
            )
        }
    </main>
    <Footer />
</Layout>
