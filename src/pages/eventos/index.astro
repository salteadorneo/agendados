---
import { getCollection } from "astro:content";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";
import List from "@/components/List.astro";
import Title from "@/components/Title.astro";

const events = (await getCollection("event"))
	.filter((event) => !event.data.startRecur)
	.sort((a, b) => b.data.start.valueOf() - a.data.start.valueOf());
---

<Layout
    title="Todos los eventos de juegos de mesa y rol"
    description="Listado completo de eventos de juegos de mesa, rol y wargames en España ordenados por fecha. Filtra por provincia o tipo de evento."
>
    <Header />
    <main class="flex-1">
        <Title title="Listado de eventos" />
        <section class="w-full max-w-6xl mx-auto px-4 py-6">
            <List events={events} />
        </section>
    </main>
    <Footer />
</Layout>
