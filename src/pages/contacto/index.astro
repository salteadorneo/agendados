---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Title from "@/components/Title.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Contacto" description="Contacta con Agendados para enviar sugerencias, corregir datos de eventos o colaborar con el proyecto de agenda de juegos de mesa y rol.">
    <Header />
    <main class="flex-1">
        <Title title="Contacto" />
        <section class="w-full max-w-6xl mx-auto">
            <form
                action="https://formsubmit.co/c326780740dec55f6c648541c576ce48"
                method="POST"
                class="max-w-md space-y-4 flex flex-col p-4"
            >
                <input type="hidden" name="_next" value="https://agendados.es/contacto/gracias">
                <input type="hidden" name="_captcha" value="false">
                <input
                    type="email"
                    name="email"
                    placeholder="Email"
                    class="border p-2"
                    required
                />
                <textarea
                    name="message"
                    placeholder="Mensaje"
                    class="border p-2"
                    rows="4"
                    required></textarea>
                <button type="submit" class="bg-primary text-white p-2">Enviar</button>
            </form>
        </section>
    </main>
    <Footer />
</Layout>
