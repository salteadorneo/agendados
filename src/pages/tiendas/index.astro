---
import { getCollection } from "astro:content";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";
import ShopCard from "@/components/ShopCard.astro";
import Title from "@/components/Title.astro";

const shops = (await getCollection("shop")).sort((a, b) =>
    b.data.name.localeCompare(a.data.name),
);
---

<Layout title="Tiendas de juegos de mesa y rol" description="Directorio de tiendas de juegos de mesa y rol en España con enlaces directos y productos recomendados.">
    <Header />
    <main class="flex-1">
        <Title title="Listado de tiendas" />
        <section class="w-full max-w-6xl mx-auto px-4 py-8">
            <p class="mb-6 max-w-2xl text-muted">
                Tiendas afines a la agenda donde encontrar juegos de mesa,
                rol y wargames. Enlace directo a su web.
            </p>
            <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {
                    shops.map(({ data }) => (
                        <ShopCard data={data} />
                    ))
                }
            </section>
        </section>
    </main>
    <Footer />
</Layout>
