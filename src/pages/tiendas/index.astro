---
import { getCollection } from "astro:content";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";
import Title from "@/components/Title.astro";

const shops = (await getCollection("shop")).sort((a, b) =>
    b.data.name.localeCompare(a.data.name),
);
---

<Layout title="Listado de tiendas">
    <Header />
    <main class="flex-1">
        <Title title="Listado de tiendas" />
        <section class="w-full max-w-6xl mx-auto px-4 py-6">
            <section class="grid grid-cols-3 gap-6">
                {
                    shops.map(({ data }) => (
                        <article
                            class="inline-block p-4 border-l-20 bg-center bg-cover bg-no-repeat hover:bg-[var(--event-color)] transition-colors"
                            style={`background-color2: ${data.color}; border-color: ${data.color}; --event-color: ${data.color || "#181818"}11;`}
                        >
                            <a
                                href={data.url}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                {/* <h3
                                    class="text-2xl md:text-3xl font-medium"
                                    style={`color: ${data.color}`}
                                >
                                    {data.name}
                                </h3> */}
                                {data.image && (
                                    <img
                                        src={data.image.toString()}
                                        alt={data.name}
                                        class="w-full h-full max-w-72 max-h-16 object-contain"
                                        itemprop="image"
                                    />
                                )}
                            </a>
                        </article>
                    ))
                }
            </section>
        </section>
    </main>
    <Footer />
</Layout>
