---
import { getCollection } from "astro:content";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";
import Title from "@/components/Title.astro";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const fmt = new Intl.DateTimeFormat("es-ES", { dateStyle: "long" });
---

<Layout
	title="Blog"
	description="Resumen semanal de los eventos de juegos de mesa, rol, miniaturas y wargames en España."
>
	<Header />
	<main class="flex-1 mb-6">
		<Title title="Blog" />
		<section class="w-full max-w-6xl mx-auto px-4 py-6">
			{posts.length === 0 && <p>Todavía no hay entradas.</p>}
			<ul class="space-y-8 max-w-3xl">
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}`} class="group block">
								<time
									datetime={post.data.date.toISOString()}
									class="text-sm text-gray-500"
								>
									{fmt.format(post.data.date)}
								</time>
								<h2 class="text-2xl group-hover:underline">
									{post.data.title}
								</h2>
								<p class="text-gray-700">{post.data.description}</p>
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</main>
	<Footer />
</Layout>
