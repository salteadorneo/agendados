---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";
import Title from "@/components/Title.astro";
import ProvinceMap from "@/components/Map.astro";
---

<Layout
    title="Organizadores de eventos de juegos de mesa"
    description="Directorio de organizadores de eventos de juegos de mesa y rol en España. Encuentra quién organiza partidas cerca de ti."
>
    <Header />
    <main class="flex-1">
        <Title title="Organizadores" />
        <section class="w-full max-w-6xl mx-auto px-4 py-6" id="mapa-organizadores">
            <div class="mb-4">
                <h2 class="text-2xl">Mapa de organizadores</h2>
                <p>
                    Haz clic en tu provincia para ver los organizadores que
                    tienen actividad en esa zona.
                </p>
            </div>
            <ProvinceMap basePath="/organizadores" />
        </section>
    </main>
    <Footer />
</Layout>
