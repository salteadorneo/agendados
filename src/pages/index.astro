---
import { getCollection } from "astro:content";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";
import Calendar from "@/components/Calendar.astro";
import Title from "@/components/Title.astro";
import EventMini from "@/components/EventMini.astro";
import EventMicro from "@/components/EventMicro.astro";
import ProvinceMap from "@/components/Map.astro";
import {
	getCurrentAgendaRange,
	getEventsInRange,
	getFutureEvents,
	provinceSlug,
} from "@/utils";

const allEvents = await getCollection("event");

const currentYear = new Date().getFullYear();
const firstEventYear = allEvents.reduce(
	(firstYear, event) => Math.min(firstYear, event.data.start.getFullYear()),
	currentYear,
);
const provincesWithEvents = new Set(
	allEvents
		.map((event) => event.data.province)
		.filter((province): province is string => Boolean(province?.trim()))
		.map(provinceSlug),
);
const activeYears = Math.max(0, currentYear - firstEventYear);

const events = allEvents.filter(
	(event) => !event.data.startRecur,
);

const futures = getFutureEvents(events);

const agendaRange = getCurrentAgendaRange();
const agenda = getEventsInRange(
	allEvents,
	agendaRange.start,
	agendaRange.end,
);

const agendaByDay = new Map<
	string,
	{ date: Date; oneOff: typeof agenda; recurring: typeof agenda }
>();
for (const event of agenda) {
	const date = event.instanceDate ?? new Date(event.data.start);
	const key = date.toDateString();

	let day = agendaByDay.get(key);
	if (!day) {
		day = { date, oneOff: [], recurring: [] };
		agendaByDay.set(key, day);
	}

	if (event.data.startRecur) day.recurring.push(event);
	else day.oneOff.push(event);
}
const today = new Date();
today.setHours(0, 0, 0, 0);
const agendaDays = [...agendaByDay.values()]
	.filter(
		(day) => day.oneOff.length > 0 || day.recurring.length > 0
	)
	.filter((day) => {
		const dayDate = new Date(day.date);
		dayDate.setHours(0, 0, 0, 0);
		return dayDate >= today;
	});

const upcomingEvents = getFutureEvents(allEvents, true, 365);
const provinceEventCounts = allEvents.reduce((counts, event) => {
	const eventProvince = event.data.province;
	if (!eventProvince) return counts;

	const province = provinceSlug(eventProvince);
	counts.set(province, (counts.get(province) ?? 0) + 1);

	return counts;
}, new Map<string, number>());
const eventCountsByProvince = Object.fromEntries(
	provinceEventCounts,
);
const provinceNextEvent = upcomingEvents.reduce((map, event) => {
	const province = event.data.province;
	if (!province) return map;

	const eventDate = event.instanceDate || new Date(event.data.start);
	const current = map.get(province);

	if (!current || eventDate < current) {
		map.set(province, eventDate);
	}

	return map;
}, new Map<string, Date>());

const upcomingProvinces = Array.from(provinceNextEvent.entries())
	.sort((a, b) => {
		const byDate = a[1].getTime() - b[1].getTime();
		if (byDate !== 0) return byDate;
		return a[0].localeCompare(b[0], "es", { sensitivity: "base" });
	})
	.map(([province]) => province);

const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"name": "Agendados",
	"url": Astro.site?.toString(),
	"alternateName": ["Agenda de eventos de rol y juegos de mesa"],
	"inLanguage": "es-ES",
	"description": "Agenda de eventos de rol y juegos de mesa en España",
};
---

<Layout
	title="Agenda de eventos de juegos de mesa y rol en España"
	description="Consulta eventos de juegos de mesa, rol y wargames por fecha y ubicación en toda España. Descubre qué se celebra cerca de ti."
>
	<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
	<Header />
	<main class="flex-1 mb-6">
		<section class="bg-primary text-white w-full py-10 md:py-12">
			<div
				class="max-w-6xl mx-auto px-4 grid gap-10 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-stretch lg:gap-12"
			>
				<div class="flex flex-col justify-center">
					<h1 class="text-3xl md:text-5xl font-light text-balance mb-3">
						Tu agenda de eventos de juegos de mesa y rol en España
					</h1>
					<p class="max-w-3xl text-white/90 text-balance mb-6">
						Consulta eventos por fecha y ubicación, descubre qué se celebra cerca de ti y accede a toda la información en un solo sitio.
					</p>
					<div
						class="flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:gap-8"
						data-province-shortcuts
					>
						<a
							data-user-province
							class="btn btn-invert hidden w-full text-base sm:w-auto"
						>
							Ver eventos en tu provincia
						</a>
						<nav
							aria-label="Provincias con próximos eventos"
							class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-white/90"
							data-other-provinces
						>
							{
								upcomingProvinces.slice(0, 6).map((province) => (
									<a
										href={`/eventos/${provinceSlug(province)}/`}
										class="underline underline-offset-4 hover:no-underline"
									>
										{province}
									</a>
								))
							}
							<a
								href="#mapa"
								class="font-medium text-white underline underline-offset-4 hover:no-underline"
							>
								Ver más provincias
							</a>
						</nav>
					</div>
				</div>
				<div
					class="hidden lg:flex lg:items-center lg:justify-center"
				>
					<ProvinceMap
						id="hero-map"
						showBadges={false}
						class="h-full max-h-88 w-auto opacity-90"
					/>
				</div>
			</div>
		</section>
		<section
			class="w-full border-y border-line bg-surface"
			aria-label="Agendados en cifras"
		>
			<div class="max-w-6xl mx-auto px-4 py-6 sm:py-8">
				<dl class="grid grid-cols-3">
					<div class="flex min-w-0 flex-col-reverse border-l border-line pl-3 first:border-0 first:pl-0 sm:pl-8">
						<dt class="text-xs leading-snug text-muted sm:text-sm">
							eventos publicados
						</dt>
						<dd class="text-3xl font-light leading-none tabular-nums text-primary sm:text-5xl">
							{allEvents.length.toLocaleString("es-ES")}
						</dd>
					</div>
					<div class="flex min-w-0 flex-col-reverse border-l border-line pl-3 sm:pl-8">
						<dt class="text-xs leading-snug text-muted sm:text-sm">
							provincias
						</dt>
						<dd class="text-3xl font-light leading-none tabular-nums text-primary sm:text-5xl">
							{provincesWithEvents.size}
						</dd>
					</div>
					<div class="flex min-w-0 flex-col-reverse border-l border-line pl-3 sm:pl-8">
						<dt class="text-xs leading-snug text-muted sm:text-sm">
							{activeYears === 1 ? "año" : "años"} online
						</dt>
						<dd class="text-3xl font-light leading-none tabular-nums text-primary sm:text-5xl">
							{activeYears}
						</dd>
					</div>
				</dl>
			</div>
		</section>
		<Title title="Calendario de eventos" />
		<section class="w-full max-w-6xl mx-auto px-4 mt-5">
			<Calendar events={events} />
		</section>
		<section class="w-full max-w-6xl mx-auto px-4 py-8">
			<div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
				<h2 class="text-2xl">Eventos {agendaRange.label}</h2>
			</div>
			{
				agendaDays.length > 0 ? (
					<ul class="flex flex-col">
						{agendaDays.map((day, index) => (
							<li
								class="grid min-w-0 gap-3 py-5 sm:grid-cols-[6rem_minmax(0,1fr)] sm:gap-6 sm:border-t sm:border-line"
								class:list={[
									index === 0 ? "sm:border-t-0 sm:pt-0" : "",
								]}
							>
								<div class="bg-ink text-white px-3 py-2 text-center">
									<p class="text-sm uppercase leading-tight tracking-wide">
										{day.date.toLocaleDateString("es-ES", { weekday: "long" })}
									</p>
									<p class="text-4xl md:text-5xl font-light leading-none tabular-nums">
										{day.date.getDate()}
									</p>
									<p class="text-sm leading-tight">
										{day.date.toLocaleDateString("es-ES", { month: "long" })}
									</p>
								</div>
								<div class="flex min-w-0 flex-col gap-4">
									{day.oneOff.length > 0 && (
										<ul class="grid gap-2 sm:grid-cols-2">
											{day.oneOff.map((event) => (
												<li>
													<EventMini {...event} />
												</li>
											))}
										</ul>
									)}
									{day.recurring.length > 0 && (
										<div>
											<h4 class="mb-2 text-sm uppercase tracking-wide text-muted">
												Recurrentes
											</h4>
											<ul class="flex max-w-full gap-2 overflow-x-auto overscroll-x-contain pb-2 snap-x snap-mandatory">
												{day.recurring.map((event) => (
													<li class="w-64 shrink-0 snap-start sm:w-72">
														<EventMicro {...event} />
													</li>
												))}
											</ul>
										</div>
									)}
								</div>
							</li>
						))}
					</ul>
				) : (
					<p class="text-muted">
						No hay eventos programados {agendaRange.label}.
					</p>
				)
			}
		</section>
		<section class="w-full max-w-6xl mx-auto px-4 mb-8" id="mapa">
			<div class="mb-4">
				<h2 class="text-2xl">Mapa</h2>
				<p>
					Haz clic en tu provincia para ver los eventos que se
					celebran cerca de ti.
				</p>
			</div>
			<ProvinceMap id="province-map" eventCounts={eventCountsByProvince} />
		</section>
		<section
			class="w-full max-w-6xl mx-auto px-4 flex flex-col xl:flex-row items-start gap-8"
		>
			<p>
				¿Quieres contribuir con un evento o corregir algún dato? La web
				es de código abierto. Entra en <a
					href="https://github.com/salteadorneo/agendados"
					class="text-primary underline hover:no-underline"
					>nuestro repositorio de GitHub</a
				> y envíanos un pull request. Si no sabes cómo hacerlo,
				<a
					href="/contacto/"
					class="text-primary underline hover:no-underline"
					>contáctanos</a
				> o escríbenos a
				<a
					href="mailto:contacto@agendados.es"
					data-simple-event="home_mailto"
					class="text-primary underline hover:no-underline"
				>
					contacto@agendados.es</a
				>.
			</p>
		</section>
	</main>
</Layout>
<Footer />

<script>
	import {
		cachedProvince,
		detectProvince,
		GEOLOCATION_EVENT,
	} from "@/geolocation";
	import { provinceSlug } from "@/utils";

	const container = document.querySelector<HTMLElement>(
		"[data-province-shortcuts]",
	);
	const userProvinceLink = container?.querySelector<HTMLAnchorElement>(
		"[data-user-province]",
	);
	const otherProvinces = container?.querySelector<HTMLElement>(
		"[data-other-provinces]",
	);

	if (container && userProvinceLink && otherProvinces) {
		let shown = false;

		// Al ser un sitio estatico, la provincia del visitante solo se conoce
		// en el navegador. Cuando la tenemos, su provincia encabeza la lista
		// como enlace destacado y el resto sigue debajo.
		const showUserProvince = (province: string | null) => {
			if (shown || !province) return;
			shown = true;

			const href = `/eventos/${provinceSlug(province)}/`;

			// Si la provincia tambien sale en el listado general, se quita de
			// ahi para no repetirla.
			otherProvinces
				.querySelectorAll<HTMLAnchorElement>(`a[href="${href}"]`)
				.forEach((item) => item.remove());

			userProvinceLink.href = href;
			userProvinceLink.textContent = `Ver eventos en ${province}`;
			userProvinceLink.classList.remove("hidden");
			userProvinceLink.classList.add("inline-flex");
		};

		// La cache primero para resolverlo sin parpadeo: la geolocalizacion
		// ya se hizo en una visita anterior.
		showUserProvince(cachedProvince());

		window.addEventListener(
			GEOLOCATION_EVENT,
			(event) => {
				const detail = (event as CustomEvent).detail as {
					province: string | null;
				} | null;
				showUserProvince(detail?.province ?? null);
			},
			{ once: true },
		);

		detectProvince();
	}
</script>

<script is:inline>
	const events = document.querySelectorAll("[data-event-start]");
	let i = 0;
	events.forEach((event) => {
		const date = new Date(event.dataset.eventStart);
		const yesterday = new Date();
		yesterday.setDate(yesterday.getDate() - 1);
		if (date > yesterday) {
			i++;
			if (i <= 4) {
				event.classList.remove("hidden");
			}
		}
	});
</script>
