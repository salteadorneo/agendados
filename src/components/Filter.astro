---
import { getCollection, type CollectionEntry } from "astro:content";
import { provinces, slugify } from "@/utils";

const events = await getCollection("event");

const tags = new Set<string>();
events.forEach((event: CollectionEntry<"event">) => {
    event.data.tags?.forEach((tag) => {
        tags.add(tag);
    });
});
---

<section class="flex flex-wrap justify-end gap-2">
    <select
        class="p-2 border text-white w-auto"
        onchange="location = this.value"
    >
        <option value="/" class="text-black">Filtro</option>
        <optgroup label="Provincias" class="text-black">
            {
                Array.from(provinces)
                    .sort((a, b) =>
                        a.localeCompare(b, "es", { sensitivity: "base" }),
                    )
                    .map((province) => (
                        <option
                            value={`/eventos/${slugify(province)}`}
                            class="text-black"
                            selected={
                                Astro.params.province === slugify(province)
                            }
                        >
                            {province}
                        </option>
                    ))
            }
        </optgroup>
        <optgroup label="Por tipo" class="text-black">
            {
                Array.from(tags)
                    .sort((a, b) =>
                        a.localeCompare(b, "es", { sensitivity: "base" }),
                    )
                    .map((tag) => (
                        <option
                            value={`/eventos/tag/${slugify(tag)}`}
                            class="text-black"
                            selected={Astro.params.tag === slugify(tag)}
                        >
                            {tag}
                        </option>
                    ))
            }
        </optgroup>
    </select>
</section>
