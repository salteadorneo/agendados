---
import { readableOn } from "@/color";

const { events, date, initialView = "dayGridMonth", showToolbarNav = true } = Astro.props;

// El texto que va sobre cada evento se calcula aquí: el script del
// calendario es inline y no tiene acceso a estos módulos.
const calendarEvents = ((events ?? []) as any[]).map((event: any) => ({
    ...event,
    textColor: readableOn(event.data.color),
}));
---

<div id="calendar" class={`h-212.5 w-full min-w-0 ${Astro.props.class}`}></div>
<style is:inline>
    :root {
        --fc-border-color: var(--color-line);
        --fc-page-bg-color: #fff;
        --fc-neutral-bg-color: var(--color-surface);

        --fc-button-bg-color: #3f3f46;
        --fc-button-border-color: #3f3f46;
        --fc-button-text-color: #fff;

        --fc-button-active-bg-color: var(--color-ink);
        --fc-button-active-border-color: var(--color-ink);
        --fc-button-active-text-color: #fff;

        --fc-button-hover-bg-color: #52525b;
        --fc-button-hover-border-color: #52525b;
        --fc-button-hover-text-color: #fff;

        --fc-event-bg-color: var(--color-primary);
        --fc-event-border-color: var(--color-primary);
        --fc-event-text-color: #fff;

        --fc-today-bg-color: var(--color-surface);
        --fc-now-indicator-color: var(--color-ink);

        --fc-highlight-color: rgba(24, 24, 24, 0.08);
        --fc-list-event-hover-bg-color: var(--color-surface);
    }

    .fc .fc-button-primary:not(:disabled).fc-button-active:focus,
    .fc .fc-button-primary:not(:disabled):active:focus {
        box-shadow: none;
    }

    .fc .fc-button-primary:focus {
        box-shadow: none;
    }

    .fc .fc-button:disabled {
        opacity: 0.2;
    }

    .event {
        &:hover {
            opacity: 0.8;
        }
    }

    .fc .fc-toolbar-title {
        @media (width < 480px) {
            font-size: 1.2rem;
            white-space: nowrap;
        }
    }
</style>
<script src="/lib/fullcalendar.min.js" is:inline></script>
<script is:inline define:vars={{ events: calendarEvents, date, initialView, showToolbarNav }}>
    const savedDate = date ?? localStorage.getItem("calendarDate");
    let initialDate = savedDate ? new Date(savedDate) : new Date();

    var calendarEl = document.getElementById("calendar");
    var calendar = new FullCalendar.Calendar(calendarEl, {
        firstDay: 1,
        locale: "es",
        initialView,
        headerToolbar: {
            start: true ? "title" : "dayGridWeek,dayGridMonth",
            center: true ? "" : "title",
            end: showToolbarNav ? "today prev,next" : "",
        },
        buttonText: {
            today: "Hoy",
            month: "Mes",
            week: "Semana",
            day: "Día",
            list: "Lista",
        },
        showNonCurrentDates: false,
        initialDate,
        events: events.map((event) => {
            const data = {
                id: event.id,
                title: event.data.title,
                url: `/evento/${event.id}/`,
                image: event.data.image,
                color: event.data.color,
                // El color del evento manda, pero el texto encima se
                // calcula para que siga leyéndose sobre él.
                textColor: event.textColor,
            };

            // Check if it's a recurring event
            if (event.data.daysOfWeek && event.data.daysOfWeek.length > 0) {
                // Recurring event
                data.daysOfWeek = event.data.daysOfWeek;
                // data.startTime = event.data.startTime || "00:00";
                // data.endTime = event.data.endTime || "23:59";
                data.startRecur = event.data.startRecur;
                data.endRecur = event.data.endRecur;
                data.allDay = true; //!event.data.startTime; // If no startTime, it's all day
                data.classNames = ["event recurring-event"]; // Different style for recurring events
            } else {
                // Regular event
                data.start = event.data.start;
                // For all-day events, end date should be the day after the last day
                if (event.data.end) {
                    const endDate = new Date(event.data.end);
                    endDate.setDate(endDate.getDate() + 1);
                    data.end = endDate.toISOString().split("T")[0];
                }
                data.allDay = true;
                data.classNames = ["event"]; // Normal event style
            }

            return data;
        }),
    });
    calendar.render();

    // FullCalendar can mis-measure when parent layouts are still settling.
    const refreshCalendarSize = () => calendar.updateSize();
    requestAnimationFrame(refreshCalendarSize);
    window.addEventListener("load", refreshCalendarSize);
    window.addEventListener("resize", refreshCalendarSize);

    let resizeObserver;
    if (typeof ResizeObserver !== "undefined") {
        resizeObserver = new ResizeObserver(refreshCalendarSize);
        resizeObserver.observe(calendarEl);
    }

    document.querySelectorAll(".fc-button-primary").forEach((button) => {
        button.addEventListener("click", function () {
            const currentDate = calendar.getDate();
            localStorage.setItem("calendarDate", currentDate.toISOString());
        });
    });

    window.addEventListener("beforeunload", () => {
        window.removeEventListener("load", refreshCalendarSize);
        window.removeEventListener("resize", refreshCalendarSize);
        resizeObserver?.disconnect();
    });
</script>
