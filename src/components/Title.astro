---
const { title } = Astro.props;
---

<header class="bg-primary text-white py-7 md:py-9">
    <div class="w-full max-w-6xl mx-auto px-4 flex items-end justify-between gap-4">
        <h1 class="text-3xl md:text-5xl font-light text-balance">
            {title}
        </h1>
        <slot />
    </div>
</header>
