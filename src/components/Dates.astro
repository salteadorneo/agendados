---
interface Props {
    start: Date;
    end?: Date;
    startTime?: string;
    endTime?: string;
    daysOfWeek?: number[];
    startRecur?: Date;
    endRecur?: Date;
}

const { start, end, startTime, endTime, daysOfWeek, startRecur, endRecur } =
    Astro.props;

const isRecurringEvent =
    startRecur && endRecur && daysOfWeek && daysOfWeek.length > 0;

const effectiveEnd = isRecurringEvent && !end ? endRecur : end;

const isSameMonth =
    start.getMonth() === (effectiveEnd?.getMonth() ?? start.getMonth());
const isSameYear =
    start.getFullYear() ===
    (effectiveEnd?.getFullYear() ?? start.getFullYear());
const isSameDay =
    start.getDate() === (effectiveEnd?.getDate() ?? start.getDate());

const startDateTime = startTime
    ? `${start.toISOString().split("T")[0]}T${startTime}:00`
    : start.toISOString();
const endDateTime =
    end && endTime
        ? `${end.toISOString().split("T")[0]}T${endTime}:00`
        : end?.toISOString() || start.toISOString();
const effectiveEndDateTime =
    isRecurringEvent && !end && endRecur ? endRecur.toISOString() : endDateTime;

const getDayName = (dayNumber: number): string => {
    const days = [
        "domingos",
        "lunes",
        "martes",
        "miércoles",
        "jueves",
        "viernes",
        "sábados",
    ];
    return days[dayNumber];
};

const formatDaysOfWeek = (days: number[]): string => {
    if (days.length === 0) return "";
    if (days.length === 1) return getDayName(days[0]);
    if (days.length === 2)
        return `${getDayName(days[0])} y ${getDayName(days[1])}`;

    const sortedDays = [...days].sort();
    const lastDay = sortedDays.pop()!;
    return `${sortedDays.map(getDayName).join(", ")} y ${getDayName(lastDay)}`;
};
---

{
    !isSameDay && isSameMonth && isSameYear ? (
        <>
            <time datetime={startDateTime} itemprop="startDate">
                {start.toLocaleDateString("es-ES", {
                    day: "numeric",
                })}
            </time>{" "}
            al{" "}
            <time
                datetime={effectiveEnd?.toISOString()}
                {...(effectiveEndDateTime !== startDateTime && {
                    itemprop: "endDate",
                    datetime: effectiveEndDateTime,
                })}
            >
                {effectiveEnd?.toLocaleDateString("es-ES", {
                    day: "numeric",
                })}
            </time>{" "}
            de{" "}
            {start.toLocaleDateString("es-ES", {
                month: "long",
                year: "numeric",
            })}
            {effectiveEndDateTime !== startDateTime && (
                <meta itemprop="endDate" content={effectiveEndDateTime} />
            )}
        </>
    ) : isSameDay && isSameMonth && isSameYear ? (
        <>
            <time datetime={startDateTime} itemprop="startDate">
                {start.toLocaleDateString("es-ES", {
                    day: "numeric",
                })}
            </time>{" "}
            {effectiveEnd && !isSameDay ? (
                <>
                    al{" "}
                    <time datetime={effectiveEndDateTime} itemprop="endDate">
                        {effectiveEnd.toLocaleDateString("es-ES", {
                            day: "numeric",
                        })}
                    </time>{" "}
                </>
            ) : null}
            de{" "}
            {start.toLocaleDateString("es-ES", {
                month: "long",
                year: "numeric",
            })}
            {effectiveEndDateTime !== startDateTime && (
                <meta itemprop="endDate" content={effectiveEndDateTime} />
            )}
        </>
    ) : isSameYear ? (
        <>
            <time datetime={startDateTime} itemprop="startDate">
                {start.toLocaleDateString("es-ES", {
                    day: "numeric",
                    month: "long",
                })}
            </time>
            {effectiveEnd && (
                <>
                    {" "}
                    -{" "}
                    <time datetime={effectiveEndDateTime} itemprop="endDate">
                        {effectiveEnd.toLocaleDateString("es-ES", {
                            day: "numeric",
                            month: "long",
                        })}
                    </time>
                </>
            )}{" "}
            de {start.getFullYear()}
            {!effectiveEnd && effectiveEndDateTime !== startDateTime && (
                <meta itemprop="endDate" content={effectiveEndDateTime} />
            )}
        </>
    ) : (
        <>
            <time datetime={startDateTime} itemprop="startDate">
                {start.toLocaleDateString("es-ES", {
                    day: "numeric",
                    month: "long",
                    year: "numeric",
                })}
            </time>
            {effectiveEnd && (
                <>
                    {" "}
                    -{" "}
                    <time datetime={effectiveEndDateTime} itemprop="endDate">
                        {effectiveEnd.toLocaleDateString("es-ES", {
                            day: "numeric",
                            month: "long",
                            year: "numeric",
                        })}
                    </time>
                </>
            )}
            {!effectiveEnd && effectiveEndDateTime !== startDateTime && (
                <meta itemprop="endDate" content={effectiveEndDateTime} />
            )}
        </>
    )
}{
    startTime || endTime ? (
        endTime ? (
            <>
                de {startTime} a {endTime}
            </>
        ) : startTime ? (
            <> a las {startTime}</>
        ) : null
    ) : null
}{isRecurringEvent ? <> ({formatDaysOfWeek(daysOfWeek!)})</> : null}
