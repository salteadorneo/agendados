---
import type { CollectionEntry } from "astro:content";
import { withAlpha } from "@/color";

interface Props {
    data: CollectionEntry<"shop">["data"];
    class?: string;
}

const { data, class: className } = Astro.props;

// El color de la tienda marca el filete y el tinte de hover, pero el
// texto se queda en tinta: el marco no compite con la marca.
const color = data.color || "#181818";
---

<article
    class:list={[
        "group flex items-center gap-4 border border-line border-l-4 bg-white p-4 transition-colors hover:bg-(--shop-tint)",
        className,
    ]}
    style={`border-left-color: ${color}; --shop-tint: ${withAlpha(color, 0.07)};`}
>
    <a
        href={data.url}
        target="_blank"
        rel="noopener noreferrer"
        class="flex min-w-0 flex-1 items-center gap-4"
    >
        {
            data.image && (
                <img
                    src={data.image.toString()}
                    alt=""
                    class="h-10 w-auto max-w-40 shrink-0 object-contain"
                    itemprop="image"
                    loading="lazy"
                />
            )
        }
        <span class="truncate text-sm font-medium">{data.name}</span>
    </a>
    <span
        aria-hidden="true"
        class="text-sm text-muted transition-colors group-hover:text-ink"
        >↗</span
    >
</article>
