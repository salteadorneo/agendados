---
import Event from "./Event.astro";

const { events } = Astro.props;

const months = new Set<string>();
events.forEach((event: any) => {
    const start = event.data.start;
    const month = start.toLocaleString("es-ES", {
        month: "long",
        year: "numeric",
    });
    months.add(month);
});
---

<section>
    <ul>
        {
            Array.from(months).map((month) => (
                <li>
                    <h2 class="mb-4 border-b border-line pb-1">
                        <a
                            href={`/eventos/${month.split(" ")[2]}/${month.split(" ")[0]}/`}
                            class="font-light text-2xl capitalize hover:text-muted transition-colors"
                        >
                            {month}
                        </a>
                    </h2>
                    <ul class="space-y-4 mb-8">
                        {events
                            .filter(
                                (event: any) =>
                                    event.data.start
                                        .toLocaleString("es-ES", {
                                            month: "long",
                                            year: "numeric",
                                        })
                                        .toLowerCase() === month,
                            )
                            .map((event: any) => (
                                <li>
                                    <Event {...event} />
                                </li>
                            ))}
                    </ul>
                </li>
            ))
        }
    </ul>
</section>
