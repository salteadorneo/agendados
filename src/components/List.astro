---
import Event from "./Event.astro";

const { events } = Astro.props;

const months = new Set<string>();
events.forEach((event: any) => {
    const start = event.data.start;
    const month = start.toLocaleString("es-ES", {
        month: "long",
        year: "numeric",
    });
    months.add(month);
});
---

<section>
    {months.size === 0 && (
        <p class="text-gray-500">Todavía no hay eventos para este mes.</p>
    )}
    <ul>
        {
            Array.from(months).map((month) => (
                <li>
                    <h2 class="inline-block py-0.5 px-3 text-white mb-4 bg-primary [clip-path:polygon(5%_0,100%_0,95%_100%,0_100%)]">
                        <a
                            href={`/eventos/${month.split(" ")[2]}/${month.split(" ")[0]}`}
                        >
                            {month}
                        </a>
                    </h2>
                    <ul class="space-y-4 mb-4">
                        {events.length === 0 && (
                            <p class="text-gray-500">Todavía no hay eventos para este mes.</p>
                        )}
                        {events
                            .filter(
                                (event: any) =>
                                    event.data.start
                                        .toLocaleString("es-ES", {
                                            month: "long",
                                            year: "numeric",
                                        })
                                        .toLowerCase() === month,
                            )
                            .map((event: any) => (
                                <li>
                                    <Event {...event} />
                                </li>
                            ))}
                    </ul>
                </li>
            ))
        }
    </ul>
</section>
