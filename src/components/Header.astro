---
import Logo from "./Logo.astro";
import { slugify } from "@/utils";

const { color } = Astro.props;

const today = new Date();
const nextMonth = new Date(today.getFullYear(), today.getMonth() + 1, 1);
const year = nextMonth.getFullYear();
const monthName = nextMonth.toLocaleString("es-ES", { month: "long" });
const monthSlug = slugify(monthName);
---

<header
    class="sticky top-0 z-40 bg-primary text-white"
    style={`background-color: ${color};`}
>
    <nav
        class="w-full max-w-6xl mx-auto p-4 flex justify-between items-center gap-4"
    >
        <a href="/">
            <Logo />
        </a>
        <div class="flex gap-4 items-center flex-wrap justify-end">
            <a
                href={`/eventos/${year}/${monthSlug}/`}
                class="hidden sm:inline px-4 py-2 rounded transition-colors"
                title={`Eventos ${monthName} ${year}`}
            >
                Eventos {monthName} {year}
            </a>
        </div>
    </nav>
</header>
