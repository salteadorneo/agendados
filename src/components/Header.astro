---
import Logo from "./Logo.astro";
import Filter from "./Filter.astro";

const { color } = Astro.props;
---

<header
    class="sticky top-0 z-40 bg-primary text-white"
    style={`background-color: ${color};`}
>
    <nav
        class="w-full max-w-6xl mx-auto p-4 flex justify-between items-center gap-4"
    >
        <a href="/">
            <Logo />
        </a>
        <div class="flex gap-4">
            <Filter />
        </div>
    </nav>
</header>
