---
import { provinceSlug, slugify } from "@/utils";

const {
    id,
    data: { tags, color, province },
    class: classes,
    provinceOnly = false,
} = Astro.props;
---

<div
    class={`flex flex-wrap items-center gap-2 [&>a:first-child]:-ml-0.5 ${classes}`}
    transition:name={`tags-${id}`}
>
    {
        !provinceOnly &&
            tags?.map((tag: string) => (
                <a
                    href={`/eventos/tag/${slugify(tag)}`}
                    class="bg-primary text-white py-0.5 px-3 [clip-path:polygon(5px_0,100%_0,95%_100%,0_100%)]"
                    style={`background-color: ${color};`}
                >
                    {tag}
                </a>
            ))
    }
    {
        province && (
            <a
                href={`/eventos/${provinceSlug(province)}`}
                class="bg-primary text-white py-0.5 px-3 [clip-path:polygon(5px_0,100%_0,95%_100%,0_100%)]"
                style={`background-color: ${color};`}
            >
                {province}
            </a>
        )
    }
</div>
