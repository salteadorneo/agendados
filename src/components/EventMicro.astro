---
import Dates from "./Dates.astro";
import Tags from "./Tags.astro";
import { readableText, withAlpha } from "@/color";

const { id, data } = Astro.props;

const titleColor = readableText(data.color);
---

{
    data && (
        <article
            class={`relative max-w-[98vw] px-3 py-2 border-l-4 hover:bg-(--event-tint) transition-colors ${Astro.props.class}`}
            style={`border-color: ${data.color}; --event: ${data.color}; --event-tint: ${withAlpha(data.color, 0.07)};`}
            data-event-start={new Date(data.start).toISOString().split("T")[0]}
        >
            <Tags id={id} data={data} class="mb-1 text-xs gap-1!" provinceOnly />
            <a href={`/evento/${id}/`}>
                <p
                    class="text-xs leading-tight font-medium text-muted"
                    transition:name={`date-${id}`}
                >
                    <Dates {...data} />
                </p>
                <h3
                    class="text-base leading-snug font-medium text-balance"
                    style={titleColor ? `color: ${titleColor}` : undefined}
                    transition:name={`title-${id}`}
                >
                    {data.title}
                </h3>
            </a>
        </article>
    )
}
