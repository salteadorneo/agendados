---
import { getCollection } from "astro:content";

const { data } = Astro.props;

const slugify = (text: string) => {
    return text
        .toString()
        .normalize('NFKD')
        .toLowerCase()
        .trim()
        .replace(/\s+/g, '-')
        .replace(/[^\w\-]+/g, '')
        .replace(/\_/g, '-')
        .replace(/\-\-+/g, '-')
        .replace(/\-$/g, '');
}

const slug = slugify(data.programName.replace(" ES", ""));
    
const shop = (await getCollection("shop")).find((shop) => shop.id === slug);
---

<a
    href={`${shop?.data.url}&url=${data.productUrl}`}
    target="_blank"
    rel="noopener noreferrer"
    class="group w-full max-w-[222px]"
>
    <div class="relative h-[250px] bg-white flex items-center">
        <div
            class="absolute inset-0 z-10"
            style="background-image: radial-gradient(rgba(0,0,0,0), rgba(0,0,0,0.01), rgba(0,0,0,0.05), rgba(0,0,0,0.05))"
        >
        </div>
        <img
            src={data.imageUrl}
            alt={data.productName}
            loading="lazy"
            decoding="async"
            class="w-[90%] h-[90%] object-contain mix-blend-multiply mx-auto group-hover:scale-105 transition-transform duration-300"
        />
    </div>
    <div class="p-2">
        <p
            class="inline-block mb-1 bg-primary text-white py-0.5 px-3 text-xs -ml-1 [clip-path:polygon(5px_0,100%_0,95%_100%,0_100%)]"
        >
            {data.programName.replace(" ES", "")}
        </p>
        <p class="text-sm line-clamp-2">
            {data.productName}
        </p>
        <p>
            <span class="font-semibold">
                {
                    new Intl.NumberFormat("es-ES", {
                        style: "currency",
                        currency: "EUR",
                    }).format(data.productPrice)
                }
            </span>
            <span class="line-through">
                {
                    new Intl.NumberFormat("es-ES", {
                        style: "currency",
                        currency: "EUR",
                    }).format(data.oldPrice)
                }
            </span>
        </p>
    </div>
</a>

